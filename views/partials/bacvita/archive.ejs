<%
  // Panel "Archivo": portafolio de fases anteriores, leído de data/db.json.
  // No se muestra en la landing; se abre con la pestaña lateral, con "Successo"
  // en el footer o con la tecla A. Cada producto abre su detalle dentro del panel.
  var cats = categories || [];
  var prods = products || [];
  var c = content || {};
  var byOrder = function (a, b) { return (a.order || 0) - (b.order || 0); };
  var catsII = cats.filter(function (x) { return x.fase === 'II'; }).sort(byOrder);
  var catsI = cats.filter(function (x) { return x.fase !== 'II'; }).sort(byOrder);
  var prodsII = prods.filter(function (p) { return p.fase === 'II'; }).sort(byOrder);
  var prodsI = prods.filter(function (p) { return p.fase !== 'II'; }).sort(byOrder);
  var catOf = function (id) { return cats.find(function (x) { return x.id === id; }) || {}; };
  // Tono por línea para los sellos de productos sin foto (líneas nuevas caen en la rotación)
  var toneMap = { hospitalarias: 'navy', industriales: 'blue', municipales: 'teal',
                  greendrain: 'teal', agroflow: 'blue', waterbridge: 'sky', hospitalwatershield: 'navy' };
  var tones = ['navy', 'blue', 'teal', 'sky', 'ink'];
  var toneOf = function (catId) {
    if (toneMap[catId]) return toneMap[catId];
    var i = cats.map(function (x) { return x.id; }).indexOf(catId);
    return tones[(i < 0 ? 0 : i) % tones.length];
  };
  var imgOf = function (p) {
    if (p.id === 'bacvita' && p.fase === 'II' && !p.productImage) return '/assets/bacvita/bacvita-bottle-front.jpg';
    return p.productImage || p.logoImage || '';
  };
  var detailProds = prods.filter(function (p) { return p.id !== 'bacvita' || p.fase !== 'II'; });
%>
<%
  // Tarjeta de producto (botón que abre el detalle dentro del panel)
  function card(p) {
    var img = imgOf(p), cat = catOf(p.category), isCurrent = p.id === 'bacvita' && p.fase === 'II';
%>
  <li class="bv-arc-card">
    <% if (isCurrent) { %>
      <a class="bv-arc-card__hit" href="#inicio" data-bv-archive-close>
    <% } else { %>
      <button class="bv-arc-card__hit" type="button" data-bv-detail="bv-detail-<%= p.id %>" aria-controls="bv-detail-<%= p.id %>">
    <% } %>
        <span class="bv-arc-card__media<%= img ? '' : ' bv-arc-card__media--seal bv-tone--' + toneOf(p.category) %>">
          <% if (img) { %>
            <img src="<%= img %>" alt="" loading="lazy" decoding="async">
          <% } else { %>
            <span class="bv-seal" aria-hidden="true"><%= (p.name || '?').charAt(0) %></span>
          <% } %>
        </span>
        <span class="bv-arc-card__body">
          <span class="bv-arc-card__line"><%= cat.name || '' %></span>
          <span class="bv-arc-card__name"><%= p.name %></span>
          <span class="bv-arc-card__sub"><%= isCurrent ? 'Hoy es BacVita by Successo: el producto de esta página.' : p.subtitle %></span>
          <span class="bv-arc-card__more"><%= isCurrent ? 'Volver a la página' : 'Ver detalle' %></span>
        </span>
    <% if (isCurrent) { %></a><% } else { %></button><% } %>
  </li>
<% } %>

<button class="bv-archive-tab" type="button" data-bv-archive-open aria-controls="bv-archive" aria-expanded="false" aria-haspopup="dialog" aria-label="Abrir archivo de fases anteriores (tecla A)">Archivo</button>

<div class="bv-archive" id="bv-archive" hidden>
  <aside class="bv-archive__drawer" id="bv-archive-drawer" role="dialog" aria-modal="true" aria-labelledby="bv-archive-title">
    <div class="bv-archive__head">
      <div>
        <p class="bv-kicker">Archivo Successo</p>
        <h2 id="bv-archive-title">Portafolio anterior</h2>
        <p>Las líneas que se mostraban antes en EcoProduct, ordenadas por fase.</p>
      </div>
      <button class="bv-archive__close" type="button" id="bv-archive-close" aria-label="Cerrar archivo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <div class="bv-archive__list" id="bv-archive-list">
      <div class="bv-archive__tabs" role="tablist" aria-label="Fases">
        <button role="tab" type="button" id="bv-tab-2" aria-selected="true" aria-controls="bv-panel-2" tabindex="0">Fase II</button>
        <button role="tab" type="button" id="bv-tab-1" aria-selected="false" aria-controls="bv-panel-1" tabindex="-1">Fase I</button>
        <button role="tab" type="button" id="bv-tab-0" aria-selected="false" aria-controls="bv-panel-0" tabindex="-1">EcoProduct</button>
      </div>

      <div class="bv-archive__panel" id="bv-panel-2" role="tabpanel" aria-labelledby="bv-tab-2">
        <div class="bv-arc-intro">
          <% if (c.faseIITitle) { %><h3><%= c.faseIITitle %></h3><% } %>
          <% if (c.faseIIIntro) { %><p><%= c.faseIIIntro %></p><% } %>
        </div>
        <ul class="bv-arc-grid bv-arc-grid--big">
          <% prodsII.forEach(function (p) { card(p); }) %>
        </ul>
      </div>

      <div class="bv-archive__panel" id="bv-panel-1" role="tabpanel" aria-labelledby="bv-tab-1" hidden>
        <div class="bv-arc-intro">
          <% if (c.faseITitle) { %><h3><%= c.faseITitle %></h3><% } %>
          <% if (c.faseISubtitle) { %><p><%= c.faseISubtitle %></p><% } %>
        </div>
        <% catsI.forEach(function (cat) {
             var list = prodsI.filter(function (p) { return p.category === cat.id; }); %>
          <section class="bv-arc-line">
            <div class="bv-arc-line__head">
              <span class="bv-arc-line__dot bv-tone--<%= toneOf(cat.id) %>" aria-hidden="true"></span>
              <h4><%= cat.name %></h4>
              <p><%= cat.description %></p>
            </div>
            <% if (list.length) { %>
              <ul class="bv-arc-grid">
                <% list.forEach(function (p) { card(p); }) %>
              </ul>
            <% } else { %>
              <p class="bv-arc-line__empty">Esta línea no tiene productos publicados.</p>
            <% } %>
          </section>
        <% }) %>
      </div>

      <div class="bv-archive__panel" id="bv-panel-0" role="tabpanel" aria-labelledby="bv-tab-0" hidden>
        <figure class="bv-arc-banner">
          <% if (c.heroImage) { %><img src="<%= c.heroImage %>" alt="" loading="lazy" decoding="async"><% } %>
          <figcaption>
            <% if (c.heroTitle) { %><strong><%= c.heroTitle %></strong><% } %>
            <% if (c.heroTagline) { %><span><%= c.heroTagline %></span><% } %>
          </figcaption>
        </figure>
        <div class="bv-arc-intro">
          <% if (c.aboutTitle) { %><h3><%= c.aboutTitle %></h3><% } %>
          <% if (c.aboutText) { %><p><%= c.aboutText %></p><% } %>
        </div>
        <% var con = c.conceptos ? Object.keys(c.conceptos).map(function (k) { return c.conceptos[k]; }) : []; %>
        <% if (con.length) { %>
          <h4 class="bv-arc-sub"><%= c.conceptosTitle || 'Concepto de negocio' %></h4>
          <% if (c.conceptosIntro) { %><p class="bv-arc-note"><%= c.conceptosIntro %></p><% } %>
          <ol class="bv-arc-concepts">
            <% con.forEach(function (k) { %>
              <li><b><%= k.titulo %></b><span><%= k.texto %></span></li>
            <% }) %>
          </ol>
        <% } %>
      </div>
    </div>

    <% detailProds.forEach(function (p) {
         var img = imgOf(p), cat = catOf(p.category); %>
      <section class="bv-arc-detail" id="bv-detail-<%= p.id %>" aria-labelledby="bv-detail-<%= p.id %>-title" hidden>
        <button class="bv-arc-detail__back" type="button" data-bv-detail-back>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          Volver al archivo
        </button>
        <div class="bv-arc-detail__top">
          <div class="bv-arc-detail__media<%= img ? '' : ' bv-arc-card__media--seal bv-tone--' + toneOf(p.category) %>">
            <% if (img) { %><img src="<%= img %>" alt="<%= p.name %>" loading="lazy" decoding="async"><% } else { %><span class="bv-seal" aria-hidden="true"><%= (p.name || '?').charAt(0) %></span><% } %>
          </div>
          <div>
            <p class="bv-arc-card__line">Fase <%= p.fase || 'I' %> · <%= cat.name || '' %></p>
            <h3 id="bv-detail-<%= p.id %>-title"><%= p.name %></h3>
            <p class="bv-arc-detail__sub"><%= p.subtitle %></p>
            <% if (p.format) { %><p class="bv-arc-detail__format"><span>Formato</span> <%= p.format %></p><% } %>
          </div>
        </div>
        <% if (p.description) { %><p class="bv-arc-detail__desc"><%= p.description %></p><% } %>
        <% if (p.benefits && p.benefits.length) { %>
          <ul class="bv-checks bv-arc-detail__benefits">
            <% p.benefits.forEach(function (b) { %><li><%= b %></li><% }) %>
          </ul>
        <% } %>
        <a class="bv-arc-detail__link" href="/producto/<%= p.id %>">Ver la ficha completa en EcoProduct</a>
      </section>
    <% }) %>
  </aside>
</div>
